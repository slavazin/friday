      "GainNode": "readonly",
      "event": "readonly"
    }
  },
  "linterOptions": {
    "noInlineConfig": true,
    "reportUnusedDisableDirectives": "off"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-redeclare": "error",
    "no-constant-condition": "error",
    "no-empty": "error"
  }
}
